# A variant of the lab kernel with the eBPF interpreter REACHABLE.
#
# CONFIG_BPF_JIT_ALWAYS_ON compiles ___bpf_prog_run out entirely, which is why
# `jit_interp_diff` has been None on every capture this project has ever taken and the
# jit_interp_divergence invariant has never examined a single record (measured in 0066).
# Turning it off leaves the JIT present but makes `net.core.bpf_jit_enable=0` legal, so the
# same program can be executed by two independent implementations INSIDE the kernel.
CONFIG_BPF_JIT_ALWAYS_ON=n

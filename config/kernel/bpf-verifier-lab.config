# eBPF verifier lab — kernel .config FRAGMENT (merge into a bpf-next defconfig).
#
# Usage (planned; see justfile build-kernel):
#   ./scripts/kconfig/merge_config.sh -m .config config/kernel/bpf-verifier-lab.config
#   make olddefconfig
#
# SCAFFOLDING: symbol set is a starting point.
# TODO(kernel-config): pin exact options against the target bpf-next revision;
# some symbols are arch/toolchain-dependent and may need adjustment.

# --- eBPF core + JIT ---------------------------------------------------------
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_HAVE_EBPF_JIT=y
# TODO(kernel-config): decide unpriv posture (CONFIG_BPF_UNPRIV_DEFAULT_OFF).

# --- Coverage (KCOV) for syzkaller -------------------------------------------
CONFIG_KCOV=y
CONFIG_KCOV_INSTRUMENT_ALL=y
CONFIG_KCOV_ENABLE_COMPARISONS=y
CONFIG_DEBUG_FS=y

# --- Sanitizers --------------------------------------------------------------
# NOTE (verified 2026-08-24): KASAN and KCSAN are MUTUALLY EXCLUSIVE in one build —
# `olddefconfig` keeps KASAN and silently drops KCSAN=y below. The primary hunt
# kernel runs KASAN (memory safety; closest to corruption->primitive). KCSAN
# (data-race hunting) needs a SEPARATE build with KASAN off. See devlog 0008.
CONFIG_KASAN=y
CONFIG_KASAN_INLINE=y
CONFIG_KCSAN=y
CONFIG_UBSAN=y
# TODO(kernel-config): add UBSAN sub-options (bounds, shift, ...) per bpf-next.

# --- BTF / pahole prerequisites (DEBUG_INFO_BTF) -----------------------------
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y
CONFIG_PAHOLE_HAS_SPLIT_BTF=y
# NOTE: DEBUG_INFO_BTF requires pahole (dwarves) on the BUILD host (>= 1.16;
# newer bpf-next may want a newer pahole).
# TODO(kernel-config): verify pahole version in the build env (justfile build-kernel).

# --- binfmt_misc: not a verifier symbol, but syzkaller's machine setup tries to
#     mount /proc/sys/fs/binfmt_misc; without this the mount fails and syzkaller
#     records it as a crash (`SYZFAIL: mount(binfmt_misc) failed`), churning VMs.
#     Neutral to the BPF hunt surface. See devlog 0028 / F1 pipeline-unblock.
CONFIG_BINFMT_MISC=y

# --- Fuzzing / debug ergonomics ----------------------------------------------
CONFIG_DEBUG_KERNEL=y
CONFIG_FRAME_POINTER=y
CONFIG_GDB_SCRIPTS=y
# TODO(kernel-config): panic_on_warn / oops=panic and friends per harness policy.

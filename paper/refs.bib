%% PROVENANS: Read from source (coinse.github.io PDF). The canonical formalism, and
%%   the axis's absence is IN the definition. §5.1: "A pseudo-oracle is an alternative
%%   version of the program produced independently, e.g. by a different programming
%%   team or written in an entirely different programming language", formalised as
%%   f1(x)o1 f2(x)o2 : [f1 != f2 AND o1 = o2] -- the independence condition quantifies
%%   over the IMPLEMENTATIONS f, while the input x is shared and unexamined. §2:
%%   "compare the output of independently implemented components of the SUT on the
%%   same input value." No Knight-Leveson-style critique of the independence
%%   assumption appears in the text (searched: knight, leveson, correlated,
%%   "fail independently" -- no hits).
@article{barr2015oracle,
  author  = {Barr, Earl T. and Harman, Mark and McMinn, Phil and
             Shahbaz, Muzammil and Yoo, Shin},
  title   = {The Oracle Problem in Software Testing: A Survey},
  journal = {IEEE Transactions on Software Engineering},
  volume  = {41},
  number  = {5},
  pages   = {507--525},
  year    = {2015},
  doi     = {10.1109/TSE.2014.2372785}
}

%% PROVENANS: Read from source (utah preprint PDF). §3.3 "No ground truth" states the
%%   shared-defect limitation outright: "Of course, if that did happen we would not
%%   detect that problem; this is an inherent limitation of differential testing
%%   without an oracle." And it engages the independence question empirically, over
%%   IMPLEMENTATIONS: "despite the fact that Knight and Leveson found a substantial
%%   number of correlated errors in an experiment on N-version programming, Csmith has
%%   yielded no evidence of correlated failures among unrelated C compilers." The test
%%   program is generated by Csmith, i.e. by NEITHER compiler -- the favourable side
%%   of the input axis -- but the paper never states this as a reason.
@inproceedings{yang2011csmith,
  author    = {Yang, Xuejun and Chen, Yang and Eide, Eric and Regehr, John},
  title     = {Finding and understanding bugs in {C} compilers},
  booktitle = {Proceedings of the 32nd ACM SIGPLAN Conference on Programming
               Language Design and Implementation (PLDI)},
  year      = {2011},
  doi       = {10.1145/1993498.1993532}
}

